# Cloudflare DNS challenge + real client IP
#
# Modules: caddy-dns/cloudflare, caddy-cloudflare-ip
#
# Required env:
#   CF_API_TOKEN  — Cloudflare API token (Zone:DNS:Edit)

{
	# Use Cloudflare DNS challenge for all sites
	acme_dns cloudflare {env.CF_API_TOKEN}

	# Keep the trusted proxy list in sync with Cloudflare's IP ranges.
	# Caddy will periodically fetch the latest ranges automatically.
	servers {
		trusted_proxies cloudflare
	}
}

example.com {
	reverse_proxy localhost:8080
}
