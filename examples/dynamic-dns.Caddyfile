# Dynamic DNS with Cloudflare
#
# Modules: caddy-dynamicdns, caddy-dns/cloudflare
#
# Automatically pushes your server's public IP as an A/AAAA record
# to Cloudflare. Ideal for homelabs with a changing WAN address.
#
# Required env:
#   CF_API_TOKEN  — Cloudflare API token (Zone:DNS:Edit)

{
	acme_dns cloudflare {env.CF_API_TOKEN}

	dynamic_dns {
		provider cloudflare {env.CF_API_TOKEN}
		domains {
			example.com @ www
		}
		# Check for IP changes every 5 minutes
		check_interval 5m
	}
}

example.com {
	reverse_proxy localhost:8080
}

www.example.com {
	redir https://example.com{uri} permanent
}
